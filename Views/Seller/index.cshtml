@{
}
<h2>My Products</h2>

<a href="/Seller/Create">Add Product</a>

<table>
    <tr>
        <th>Name</th>
        <th>Price</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
        </tr>
    }
</table>