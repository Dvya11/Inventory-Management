@{
}
<h2>My Orders</h2>

<table>
    <tr>
        <th>Product</th>
        <th>Quantity</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Product.Name</td>
            <td>@item.Quantity</td>
        </tr>
    }
</table>