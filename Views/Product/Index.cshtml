@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products Catalog";
}

<style>
    /* Scoped styles */
    :root {
        --primary: #E11D48;
        --primary-hover: #BE123C;
        --bg-card: #FFFFFF;
        --text-main: #4C0519;
        --text-muted: #9F1239;
        --danger: #EE5D50;
        --success: #01B574;
        --warning: #FFCE20;
        --border: #FCE7EB;
    }
    
    .product-container {
        padding: 5px;
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: -0.5px;
        margin: 0;
    }

    .btn-primary {
        background-color: var(--primary);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        text-decoration: none;
    }

    .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
        color: white;
    }

    /* FILTERS & SEARCH */
    .filters-bar {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        background: var(--bg-card);
        padding: 16px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .search-box {
        flex: 1;
        position: relative;
    }

    .search-box i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    .search-input {
        width: 100%;
        padding: 10px 14px 10px 40px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: 0.2s;
    }

    .search-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.1);
    }

    .filter-select {
        padding: 10px 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: white;
        color: var(--text-main);
        outline: none;
        cursor: pointer;
    }

    /* TABLE */
    .data-card {
        background-color: var(--bg-card);
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .product-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .product-table th {
        text-align: left;
        padding: 16px;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--border);
        background: rgba(255, 247, 248, 0.5);
    }

    .product-table td {
        padding: 16px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text-main);
        font-weight: 500;
        vertical-align: middle;
        transition: background 0.2s ease;
    }

    .product-table tr:last-child td {
        border-bottom: none;
    }

    .product-table tr:hover td {
        background-color: rgba(255, 247, 248, 0.8);
    }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .product-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background-color: rgba(225, 29, 72, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-size: 16px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }

    .status-success { background: rgba(1, 181, 116, 0.1); color: var(--success); }
    .status-warning { background: rgba(255, 206, 32, 0.1); color: var(--warning); }
    .status-danger { background: rgba(238, 93, 80, 0.1); color: var(--danger); }

    .action-btns {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: white;
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-icon:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

</style>

<!-- FontAwesome & Google Fonts -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">


<div class="product-container">
    <div class="page-header">
        <h1 class="page-title">Products Catalog</h1>
        <a asp-action="AddOrEdit" class="btn-primary">
            <i class="fa-solid fa-plus"></i> Add Product
        </a>
    </div>

    <div class="filters-bar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="search-input" placeholder="Search products by name or SKU..." />
        </div>
        <select class="filter-select">
            <option>All Categories</option>
            <option>Electronics</option>
            <option>Apparel</option>
            <option>Accessories</option>
        </select>
        <select class="filter-select">
            <option>Stock Status</option>
            <option>In Stock</option>
            <option>Low Stock</option>
            <option>Out of Stock</option>
        </select>
    </div>

    <div class="data-card">
        <div style="overflow-x: auto;">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td style="color: var(--text-muted); font-weight: 500;">#@item.Id.ToString("D4")</td>
                            <td>
                                <div class="product-cell">
                                    <div class="product-icon"><i class="fa-solid fa-box"></i></div>
                                    <span style="font-weight: 600;">@item.Name</span>
                                </div>
                            </td>
                            <td style="font-weight: 600;">₹@item.Price.ToString("N2")</td>
                            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Description</td>
                            <td>
                                <div class="action-btns">
                                    <a asp-action="AddOrEdit" asp-route-id="@item.Id" class="btn-icon" title="Edit">
                                        <i class="fa-solid fa-pen" style="font-size: 13px;"></i>
                                    </a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display:inline;">
                                        <button type="submit" class="btn-icon" title="Delete" style="color: var(--danger); border-color: rgba(238, 93, 80, 0.3);">
                                            <i class="fa-solid fa-trash" style="font-size: 13px;"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
