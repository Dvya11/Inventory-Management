@model IEnumerable<StockTransaction>

@{
    ViewData["Title"] = "Stock Management";
}

<style>
    :root {
        --primary: #E11D48;
        --primary-hover: #BE123C;
        --bg-card: #FFFFFF;
        --text-main: #4C0519;
        --text-muted: #9F1239;
        --danger: #EE5D50;
        --success: #01B574;
        --warning: #FFCE20;
        --border: #FCE7EB;
        --blue: #3b82f6;
    }
    
    .page-container {
        padding: 5px;
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: -0.5px;
        margin: 0;
    }

    .btn-primary {
        background-color: var(--primary);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        text-decoration: none;
    }

    .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
        color: white;
    }

    /* FILTERS & SEARCH */
    .filters-bar {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        background: var(--bg-card);
        padding: 16px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .search-box {
        flex: 1;
        position: relative;
    }

    .search-box i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    .search-input {
        width: 100%;
        padding: 10px 14px 10px 40px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: 0.2s;
    }

    .search-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.1);
    }

    /* TABLE */
    .data-card {
        background-color: var(--bg-card);
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .custom-table th {
        text-align: left;
        padding: 16px;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--border);
        background: rgba(255, 247, 248, 0.5);
    }

    .custom-table td {
        padding: 16px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text-main);
        font-weight: 500;
        vertical-align: middle;
        transition: background 0.2s ease;
    }

    .custom-table tr:hover td {
        background-color: rgba(255, 247, 248, 0.8);
    }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .product-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background-color: rgba(225, 29, 72, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-size: 16px;
    }

    .badge-in {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
        background: rgba(1, 181, 116, 0.1);
        color: var(--success);
    }

    .badge-out {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
        background: rgba(238, 93, 80, 0.1);
        color: var(--danger);
    }

    .badge-warning {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
        background: rgba(255, 206, 32, 0.1);
        color: var(--warning);
    }

</style>

<!-- FontAwesome & Google Fonts -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">


<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Stock Transactions</h1>
        <a asp-action="Create" class="btn-primary">
            <i class="fa-solid fa-arrow-right-arrow-left"></i> Add Transaction
        </a>
    </div>

    <div class="filters-bar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="search-input" placeholder="Search product name or ID..." />
        </div>
    </div>

    <!-- PRODUCTS SECTION -->
    <div style="margin-bottom: 40px;">
        <h2 style="font-size: 24px; font-weight: 700; color: var(--text-main); margin-bottom: 20px;">
            <i class="fa-solid fa-boxes-stacked" style="margin-right: 10px;"></i> All Products
        </h2>
        
        <div class="data-card">
            <div style="overflow-x: auto;">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Current Stock</th>
                            <th>Low Stock Threshold</th>
                            <th>Stock Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var allProducts = (List<Product>)ViewBag.AllProducts ?? new List<Product>();
                        }
                        @if (allProducts.Any())
                        {
                            @foreach(var product in allProducts)
                            {
                                var statusClass = "badge-in";
                                var statusText = "In Stock";
                                var statusIcon = "fa-check-circle";
                                
                                if(product.Quantity == 0) {
                                    statusClass = "badge-out";
                                    statusText = "Out of Stock";
                                    statusIcon = "fa-circle-xmark";
                                }
                                else if (product.Quantity <= product.LowStockThreshold) {
                                    statusClass = "badge-warning";
                                    statusText = "Low Stock";
                                    statusIcon = "fa-triangle-exclamation";
                                }
                                
                                <tr>
                                    <td style="color: var(--text-muted); font-weight: 500;">#@product.Id.ToString("D4")</td>
                                    <td>
                                        <div class="product-cell">
                                            <div class="product-icon"><i class="fa-solid fa-box"></i></div>
                                            <span style="font-weight: 600;">@product.Name</span>
                                        </div>
                                    </td>
                                    <td style="font-weight: 600;">₹@product.Price.ToString("N2")</td>
                                    <td style="font-weight: 700; font-size: 15px;">@product.Quantity</td>
                                    <td>@product.LowStockThreshold</td>
                                    <td>
                                        <span class="@statusClass" style="display: inline-flex; align-items: center; gap: 6px;">
                                            <i class="fa-solid @statusIcon" style="font-size: 12px;"></i>
                                            @statusText
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                    <i class="fa-solid fa-inbox" style="font-size: 32px; margin-bottom: 15px; color: rgba(225, 29, 72, 0.2);"></i><br/>
                                    No products found in inventory.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TRANSACTION HISTORY SECTION -->
    <div>
        <h2 style="font-size: 24px; font-weight: 700; color: var(--text-main); margin-bottom: 20px;">
            <i class="fa-solid fa-history" style="margin-right: 10px;"></i> Transaction History
        </h2>

        <div class="data-card">
            <div style="overflow-x: auto;">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Product Details</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Date & Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach(var item in Model)
                            {
                                <tr>
                                    <td style="color: var(--text-muted); font-weight: 500;">
                                        #STK-@item.Id.ToString("D5")
                                    </td>
                                    <td>
                                        <div class="product-cell">
                                            <div class="product-icon"><i class="fa-solid fa-layer-group"></i></div>
                                            <span style="font-weight: 600;">@(item.Product?.Name ?? "Unknown Product")</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if(item.Type == "IN") {
                                            <span class="badge-in"><i class="fa-solid fa-arrow-down" style="padding-right:4px;"></i> IN</span>
                                        } else {
                                            <span class="badge-out"><i class="fa-solid fa-arrow-up" style="padding-right:4px;"></i> OUT</span>
                                        }
                                    </td>
                                    <td style="font-weight: 700; font-size: 15px;">
                                        @if(item.Type == "IN") {
                                            <span style="color: var(--success);">+@item.Quantity</span>
                                        } else {
                                            <span style="color: var(--danger);">-@item.Quantity</span>
                                        }
                                    </td>
                                    <td>
                                        <span style="color: var(--text-muted);">@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                    <i class="fa-solid fa-box-open" style="font-size: 32px; margin-bottom: 15px; color: rgba(225, 29, 72, 0.2);"></i><br/>
                                    No recent stock transactions found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
