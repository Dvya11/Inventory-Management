@{
    ViewData["Title"] = "Business Reports";
}

<style>
    :root {
        --primary: #E11D48;
        --primary-hover: #BE123C;
        --bg-card: #FFFFFF;
        --bg-body: #FFF7F8;
        --text-main: #4C0519;
        --text-muted: #9F1239;
        --danger: #EE5D50;
        --success: #01B574;
        --warning: #FFCE20;
        --border: #FCE7EB;
        --blue: #3b82f6;
    }
    
    .page-container {
        padding: 5px;
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: -0.5px;
        margin: 0;
    }

    .btn-primary {
        background-color: var(--primary);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        text-decoration: none;
    }

    .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
        color: white;
    }

    /* REPORTS CARDS */
    .reports-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 24px;
        margin-top: 10px;
    }

    .report-card {
        background: var(--bg-card);
        padding: 24px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        display: flex;
        flex-direction: column;
        transition: 0.2s;
        border: 1px solid var(--border);
    }
    
    .report-card:hover {
        border-color: rgba(225, 29, 72, 0.3);
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(225, 29, 72, 0.08);
    }

    .report-icon {
        width: 48px;
        height: 48px;
        background: rgba(225, 29, 72, 0.05);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 20px;
        margin-bottom: 16px;
    }

    .report-info h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 8px;
    }

    .report-info p {
        font-size: 14px;
        color: var(--text-muted);
        line-height: 1.5;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .report-action {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 4px;
        color: var(--primary);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
    }
    
    .report-action:hover {
        text-decoration: underline;
    }

</style>

<!-- FontAwesome & Google Fonts -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">


<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Analytics & Reports</h1>
    </div>

    <div class="reports-grid">
        <div class="report-card">
            <div class="report-icon"><i class="fa-solid fa-money-bill-trend-up"></i></div>
            <div class="report-info">
                <h3>Sales & Revenue Summary</h3>
                <p>Generate detailed insights on daily, weekly, or monthly gross and net sales patterns and comparisons.</p>
            </div>
            <a href="#" class="report-action">Generate Report <i class="fa-solid fa-arrow-right" style="font-size:12px; margin-left:4px;"></i></a>
        </div>
        
        <div class="report-card">
            <div class="report-icon"><i class="fa-solid fa-layer-group"></i></div>
            <div class="report-info">
                <h3>Inventory Valuation</h3>
                <p>Track your current physical storage values based on moving average costs to assess current capital locked.</p>
            </div>
            <a href="#" class="report-action">Generate Report <i class="fa-solid fa-arrow-right" style="font-size:12px; margin-left:4px;"></i></a>
        </div>

        <div class="report-card">
            <div class="report-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="report-info">
                <h3>Replenishment & Shortages</h3>
                <p>Identify items hitting low threshold marks actively requiring rapid purchasing logic to prevent stockouts.</p>
            </div>
            <a href="#" class="report-action">Generate Report <i class="fa-solid fa-arrow-right" style="font-size:12px; margin-left:4px;"></i></a>
        </div>

        <div class="report-card">
            <div class="report-icon"><i class="fa-solid fa-users"></i></div>
            <div class="report-info">
                <h3>Supplier Performance</h3>
                <p>Review supplier lead times, fill ratios, delivery reliability and purchasing velocity patterns.</p>
            </div>
            <a href="#" class="report-action">Generate Report <i class="fa-solid fa-arrow-right" style="font-size:12px; margin-left:4px;"></i></a>
        </div>
    </div>
</div>
