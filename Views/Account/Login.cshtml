@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Login</title>

    <style>
        :root {
            --bg-start: #f6fbff;
            --bg-end: #eef9f7;
            --primary: #0ea5e9;
            --accent: #18c964;
            --card-bg: #ffffff;
            --muted: #6b7280;
            --danger: #dc2626;
            --radius: 12px;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: "Poppins", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
            -webkit-font-smoothing:antialiased;
            -moz-osx-font-smoothing:grayscale;
        }

        .center {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .card {
            width: 360px;
            max-width: 100%;
            background: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: 0 8px 28px rgba(16,24,40,0.08);
            padding: 24px;
            box-sizing: border-box;
        }

        h1 {
            font-size: 20px;
            margin: 0 0 8px 0;
            color: #0f172a;
        }

        p.lead {
            margin: 0 0 18px 0;
            color: var(--muted);
            font-size: 13px;
        }

        label {
            display: block;
            font-size: 13px;
            color: #111827;
            margin-bottom: 6px;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #e6e9ef;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            transition: border-color .12s, box-shadow .12s;
        }

        input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(14,165,233,0.12);
        }

        .links {
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-top: 12px;
            font-size: 13px;
        }

        .links a {
            color: var(--primary);
            text-decoration: none;
        }

        .links a:hover {
            text-decoration: underline;
        }

        .actions {
            display:flex;
            gap:10px;
            align-items:center;
            margin-top: 14px;
        }

        .btn {
            padding: 10px 12px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
        }

        .btn-primary {
            background: linear-gradient(90deg,var(--primary), #0bb3ff);
            color: white;
            flex: 1;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid #e6e9ef;
            color: #0f172a;
            padding: 9px 12px;
            font-weight: 600;
            border-radius: 8px;
        }

        .validation-summary {
            border-left: 4px solid #fee2e2;
            background: #fff7f7;
            padding: 10px 12px;
            border-radius: 6px;
            color: var(--danger);
            font-size: 13px;
            margin-bottom: 12px;
        }

        .error {
            color: var(--danger);
            font-size: 13px;
            margin-top: 8px;
        }

        .success {
            color: #16a34a;
            font-size: 13px;
            margin-top: 8px;
        }

        @media (max-width:420px){
            .card{ padding: 16px; width: 100%;}
        }
    </style>
</head>
<body>
    <div class="center">
        <div class="card" role="main" aria-labelledby="signin-title">
            <h1 id="signin-title">Sign in to your shop</h1>
            <p class="lead">Access sales, inventory and reports for your small retail shop.</p>

            @* show validation summary if there are model errors *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary" role="alert" aria-live="polite">
                    @Html.ValidationSummary(false)
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <p class="success" role="status">@TempData["Success"]</p>
            }

            @if (ViewBag.Error != null)
            {
                <p class="error" role="alert">@ViewBag.Error</p>
            }

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="you@shop.com" required autocomplete="email" autofocus />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" placeholder="Your password" required autocomplete="current-password" />
                </div>

                <div class="links">
                    <div class="muted">Don't have an account? <a asp-controller="Account" asp-action="Register">Create account</a></div>
                    <div><a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a></div>
                </div>

                <div class="actions">
                    <button type="submit" name="action" value="login" class="btn btn-primary">Sign in</button>
                    <button type="submit" name="action" value="sulogin" class="btn btn-secondary" title="Supervisor login">SU Login</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>