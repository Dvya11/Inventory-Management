@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Login</title>

    <style>
            body {
                margin: 0;
                font-family: "Poppins", sans-serif;
                /* background: linear-gradient(135deg, #0f0f0f, #1a1a1a); */
                min-height: 100vh;
            }

            .center {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .card {
                width: 380px;
                background: #ffffff;
                padding: 32px;
                border-radius: 16px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.6);
                border-top: 5px solid #ef4444;
                position: relative;
            }

                /* subtle red glow */
                .card::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    border-radius: 16px;
                    padding: 1px;
                    background: linear-gradient(45deg, #ef4444, transparent);
                    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                    -webkit-mask-composite: xor;
                    mask-composite: exclude;
                    pointer-events: none;
                }

            h1 {
                text-align: center;
                margin-bottom: 6px;
                font-size: 26px;
                color: #111;
                font-weight: 700;
            }

            .subtitle {
                text-align: center;
                margin-bottom: 22px;
                font-size: 13px;
                color: #6b7280;
            }

            label {
                font-size: 13px;
                margin-bottom: 6px;
                display: block;
                color: #111;
                font-weight: 600;
            }

            input {
                width: 100%;
                padding: 11px 12px;
                margin-bottom: 16px;
                border: 1px solid #e5e7eb;
                border-radius: 10px;
                background: #f9fafb;
                transition: all .2s;
            }

                input:focus {
                    outline: none;
                    border-color: #ef4444;
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(239,68,68,0.2);
                }

            .forgot {
                text-align: right;
                margin-bottom: 18px;
            }

                .forgot a {
                    font-size: 13px;
                    text-decoration: none;
                    color: #ef4444;
                    font-weight: 500;
                }

                    .forgot a:hover {
                        text-decoration: underline;
                    }

            .btn {
                width: 100%;
                padding: 13px;
                border: none;
                border-radius: 10px;
                background: linear-gradient(90deg, #ef4444, #b91c1c);
                color: white;
                font-weight: 600;
                font-size: 15px;
                cursor: pointer;
                transition: all .2s;
                box-shadow: 0 10px 20px rgba(239,68,68,0.35);
            }

                .btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 15px 25px rgba(239,68,68,0.5);
                }

            .error {
                color: #b91c1c;
                font-size: 13px;
                margin-bottom: 12px;
                text-align: center;
                background: #fee2e2;
                border-radius: 8px;
                padding: 8px;
            }
    </style>
</head>

<body>

    <div class="center">
        <div class="card">

            <h1>Login</h1>
            <p class="subtitle">Access your inventory dashboard</p>

            @if (ViewBag.Error != null)
            {
                <div class="error">@ViewBag.Error</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <label>Email</label>
                <input type="email" name="email" placeholder="Enter your email" required />

                <label>Password</label>
                <input type="password" name="password" placeholder="Enter your password" required />

                <div class="forgot">
                    <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                </div>

                <button type="submit" class="btn">Login</button>
            </form>

        </div>
    </div>

</body>
</html>