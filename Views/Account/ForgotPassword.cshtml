
@{
    Layout = null;
}

<style>
    body {
        background-color: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        width: 400px;
        margin: 100px auto;
        padding: 30px;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border-top: 4px solid #ff4d4d;
    }

    .card h2 {
        text-align: center;
        margin-bottom: 10px;
    }

    .card p {
        text-align: center;
        color: gray;
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        margin-bottom: 15px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        background: linear-gradient(to right, #ff4d4d, #cc0000);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-submit:hover {
        opacity: 0.9;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 15px;
        color: #ff4d4d;
        text-decoration: none;
    }
</style>

<div class="card">
    <h2>Forgot Password</h2>
    <p>Enter your email to reset your password</p>

    <form asp-action="ForgotPassword" method="post">
        <label>Email</label>
        <input type="email" name="Email" class="form-control" placeholder="Enter your email" required />

        <button type="submit" class="btn-submit">Send Reset Link</button>
    </form>

    <a asp-action="Login" class="back-link">Back to Login</a>
</div>