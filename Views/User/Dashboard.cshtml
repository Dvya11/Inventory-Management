@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<style>
    .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .card {
        background: #ffffff;
        padding: 20px;
        border-radius: 14px;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        transition: 0.2s;
    }

        .card:hover {
            transform: translateY(-3px);
        }

        .card h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }

        .card p {
            color: #777;
            font-size: 13px;
            margin-top: 5px;
        }

    .grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .box {
        background: white;
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

        .box h3 {
            margin-bottom: 15px;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

        table th {
            text-align: left;
            font-size: 13px;
            color: #555;
            padding-bottom: 10px;
        }

        table td {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

    .low {
        color: #ef4444;
        font-weight: bold;
    }
</style>

<!-- CARDS -->
<div class="cards">
    <div class="card">
        <h2>₹25,000</h2>
        <p>Total Sales</p>
    </div>
    <div class="card">
        <h2>₹15,000</h2>
        <p>Total Purchases</p>
    </div>
    <div class="card">
        <h2>45</h2>
        <p>Products</p>
    </div>
    <div class="card">
        <h2 class="low">5</h2>
        <p>Low Stock Items</p>
    </div>
</div>

<!-- GRID -->
<div class="grid">

    <!-- LEFT -->
    <div class="box">
        <h3>Recent Sales</h3>
        <table>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Amount</th>
            </tr>
            <tr>
                <td>Shirt</td>
                <td>2</td>
                <td>₹800</td>
            </tr>
            <tr>
                <td>Shoes</td>
                <td>1</td>
                <td>₹1200</td>
            </tr>
            <tr>
                <td>Bag</td>
                <td>3</td>
                <td>₹1500</td>
            </tr>
        </table>
    </div>

    <!-- RIGHT -->
    <div class="box">
        <h3>Inventory Summary</h3>
        <p>Total Stock: <b>200 Items</b></p>
        <p>Low Stock: <span class="low">5 Items</span></p>
        <p>Out of Stock: 2 Items</p>
    </div>

</div>

<!-- EXTRA -->
<div class="box" style="margin-top:20px;">
    <h3>Top Selling Products</h3>
    <table>
        <tr>
            <th>Product</th>
            <th>Sold</th>
        </tr>
        <tr>
            <td>T-Shirt</td>
            <td>25</td>
        </tr>
        <tr>
            <td>Jeans</td>
            <td>18</td>
        </tr>
        <tr>
            <td>Cap</td>
            <td>12</td>
        </tr>
    </table>
</div>