@{
    ViewData["Title"] = "Dashboard";
}

<style>
    :root {
        --primary: #E11D48; /* Vibrant Rose/Red */
        --primary-hover: #BE123C;
        --bg-card: #FFFFFF;
        --text-main: #4C0519; /* Deep red used as dark main text */
        --text-muted: #9F1239;
        --danger: #EE5D50;
        --success: #01B574;
        --warning: #FFCE20;
        --border: #FCE7EB;
    }

    /* DASHBOARD CONTENT */
    .dashboard-container {
        padding: 5px;
        font-family: 'Inter', sans-serif;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 30px;
        color: var(--text-main);
        letter-spacing: -0.5px;
    }

    /* STATS CARDS */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

    .stat-card {
        background-color: var(--bg-card);
        padding: 24px;
        border-radius: 20px;
        box-shadow: 0 5px 14px rgba(0, 0, 0, 0.02);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(225, 29, 72, 0.1);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
    }
    
    .stat-card:hover::before {
        opacity: 1;
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
        z-index: 1;
    }

    .icon-sales { background-color: rgba(1, 181, 116, 0.1); color: var(--success); }
    .icon-purchases { background-color: rgba(225, 29, 72, 0.1); color: var(--primary); }
    .icon-products { background-color: rgba(255, 206, 32, 0.1); color: var(--warning); }
    .icon-alerts { background-color: rgba(238, 93, 80, 0.1); color: var(--danger); }

    .stat-info {
        z-index: 1;
    }

    .stat-info h3 {
        font-size: 14px;
        color: var(--text-muted);
        font-weight: 500;
        margin-bottom: 6px;
        margin-top: 0;
    }

    .stat-info .value {
        font-size: 26px;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: -0.5px;
    }

    /* DATA SECTIONS */
    .data-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    .data-card {
        background-color: var(--bg-card);
        border-radius: 20px;
        box-shadow: 0 5px 14px rgba(0, 0, 0, 0.02);
        padding: 28px;
    }

    .data-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .data-header h3 {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-main);
        margin: 0;
    }

    .btn-view-all {
        background: rgba(225, 29, 72, 0.1);
        border: none;
        color: var(--primary);
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 30px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.2s ease;
    }

    .btn-view-all:hover {
        background: var(--primary);
        color: white;
        box-shadow: 0 4px 10px rgba(225, 29, 72, 0.25);
    }

    /* TABLES */
    .dashboard-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .dashboard-table th {
        text-align: left;
        padding: 12px 16px;
        color: var(--text-muted);
        font-weight: 500;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--border);
    }

    .dashboard-table td {
        padding: 16px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text-main);
        font-weight: 600;
        vertical-align: middle;
        transition: background 0.2s ease;
    }

    .dashboard-table tr:last-child td {
        border-bottom: none;
    }

    .dashboard-table tr:hover td {
        background-color: rgba(255, 247, 248, 0.8);
    }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .product-img {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background-color: rgba(225, 29, 72, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-size: 18px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }

    .status-success { background: rgba(1, 181, 116, 0.1); color: var(--success); }
    .status-warning { background: rgba(255, 206, 32, 0.1); color: var(--warning); }
    .status-danger { background: rgba(238, 93, 80, 0.1); color: var(--danger); }

    /* INVENTORY LIST */
    .inventory-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 10px;
    }

    .inventory-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .inventory-item-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .inventory-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(225, 29, 72, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-main);
        font-size: 20px;
    }

    .inventory-info h4 {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 4px;
        color: var(--text-main);
        margin-top: 0;
    }

    .inventory-info p {
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 500;
        margin: 0;
    }

    .stock-value {
        font-weight: 700;
        font-size: 14px;
        background: rgba(255, 247, 248, 0.9);
        padding: 6px 12px;
        border-radius: 8px;
    }

    .stock-value.low {
        color: var(--danger);
        background: rgba(238, 93, 80, 0.1);
    }

    /* RESPONSIVE */
    @@media (max-width: 1200px) {
        .data-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- FontAwesome & Google Fonts -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="dashboard-container">
    <h1 class="page-title">General Dashboard</h1>

    <!-- STATS CARDS -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon icon-sales">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="stat-info">
                <h3>Today's Sales</h3>
                <div class="value">₹32,050</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-purchases">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <div class="stat-info">
                <h3>Total Purchases</h3>
                <div class="value">₹15,200</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-products">
                <i class="fa-solid fa-boxes-packing"></i>
            </div>
            <div class="stat-info">
                <h3>Inventory Items</h3>
                <div class="value">486</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-alerts">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="stat-info">
                <h3>Low Stock</h3>
                <div class="value" style="color: var(--danger)">12</div>
            </div>
        </div>
    </div>

    <!-- DATA SECTIONS -->
    <div class="data-grid">
        
        <!-- RECENT ORDERS TABLE -->
        <div class="data-card">
            <div class="data-header">
                <h3>Recent Sales</h3>
                <button class="btn-view-all">View Full Log</button>
            </div>
            <div style="overflow-x: auto;">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="product-cell">
                                    <div class="product-img"><i class="fa-solid fa-shirt"></i></div>
                                    <span>Premium Polo Shirt</span>
                                </div>
                            </td>
                            <td>Oct 24, 2026</td>
                            <td><span class="status-badge status-success">Completed</span></td>
                            <td>₹1,450</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="product-cell">
                                    <div class="product-img"><i class="fa-solid fa-shoe-prints"></i></div>
                                    <span>Nike Air Max 2026</span>
                                </div>
                            </td>
                            <td>Oct 24, 2026</td>
                            <td><span class="status-badge status-warning">Pending</span></td>
                            <td>₹8,200</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="product-cell">
                                    <div class="product-img"><i class="fa-solid fa-headphones"></i></div>
                                    <span>Sony WH-1000XM5</span>
                                </div>
                            </td>
                            <td>Oct 23, 2026</td>
                            <td><span class="status-badge status-success">Completed</span></td>
                            <td>₹21,100</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="product-cell">
                                    <div class="product-img"><i class="fa-solid fa-laptop"></i></div>
                                    <span>MacBook Pro 14" Case</span>
                                </div>
                            </td>
                            <td>Oct 23, 2026</td>
                            <td><span class="status-badge status-danger">Cancelled</span></td>
                            <td>₹1,850</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- STOCK ALERTS -->
        <div class="data-card">
            <div class="data-header">
                <h3>Critical Stock</h3>
                <button class="btn-view-all">Restock</button>
            </div>
            <div class="inventory-list">
                <div class="inventory-item">
                    <div class="inventory-item-left">
                        <div class="inventory-icon"><i class="fa-solid fa-mug-hot"></i></div>
                        <div class="inventory-info">
                            <h4>Organic Ground Coffee</h4>
                            <p>SKU: CF-1029</p>
                        </div>
                    </div>
                    <div class="stock-value low">2 Left</div>
                </div>
                <div class="inventory-item">
                    <div class="inventory-item-left">
                        <div class="inventory-icon"><i class="fa-solid fa-glasses"></i></div>
                        <div class="inventory-info">
                            <h4>Ray-Ban Aviators</h4>
                            <p>SKU: RB-3025</p>
                        </div>
                    </div>
                    <div class="stock-value low">1 Left</div>
                </div>
                <div class="inventory-item">
                    <div class="inventory-item-left">
                        <div class="inventory-icon"><i class="fa-solid fa-mobile-screen"></i></div>
                        <div class="inventory-info">
                            <h4>iPhone 15 Case</h4>
                            <p>SKU: AP-IP15C</p>
                        </div>
                    </div>
                    <div class="stock-value" style="color: var(--warning);">8 Left</div>
                </div>
                <div class="inventory-item">
                    <div class="inventory-item-left">
                        <div class="inventory-icon"><i class="fa-solid fa-keyboard"></i></div>
                        <div class="inventory-info">
                            <h4>Mechanical Keyboard</h4>
                            <p>SKU: KB-4491</p>
                        </div>
                    </div>
                    <div class="stock-value low">0 Left</div>
                </div>
            </div>
        </div>

    </div>
</div>