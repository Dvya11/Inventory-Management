@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #f7f8fa;
    }

    .layout {
        display: flex;
    }

    /* SIDEBAR */
    .sidebar {
        width: 230px;
        height: 100vh;
        background: #111;
        color: white;
        position: fixed;
        padding: 20px 0;
    }

    .logo {
        font-size: 20px;
        font-weight: bold;
        padding: 0 20px;
        margin-bottom: 30px;
    }

    .logo span {
        color: #ff3b3b;
    }

    .menu a {
        display: block;
        padding: 12px 20px;
        color: #bbb;
        text-decoration: none;
    }

    .menu a:hover {
        background: #ff3b3b;
        color: white;
    }

    /* MAIN */
    .main {
        margin-left: 230px;
        padding: 20px 30px;
        width: 100%;
    }

    .header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .search {
        padding: 10px;
        width: 300px;
        border-radius: 20px;
        border: none;
        background: #eef1f5;
    }

    /* CARDS */
    .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .card {
        background: white;
        padding: 18px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .card h2 {
        margin: 0;
        font-size: 22px;
    }

    .card p {
        color: gray;
        font-size: 13px;
    }

    /* GRID */
    .grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .box {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    table th, table td {
        padding: 10px;
        border-bottom: 1px solid #eee;
    }

    .low {
        color: red;
        font-weight: bold;
    }
</style>

<div class="layout">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="logo">📦 <span>Shop Inventory</span></div>

        <div class="menu">
            <a href="#">Dashboard</a>
            <a href="#">Products</a>
            <a href="#">Sales</a>
            <a href="#">Purchases</a>
            <a href="#">Suppliers</a>
            <a href="#">Reports</a>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main">

        <!-- HEADER -->
        <div class="header">
            <input type="text" class="search" placeholder="Search product..." />
            <div>Welcome, Shop Owner</div>
        </div>

        <!-- TOP CARDS -->
        <div class="cards">
            <div class="card">
                <h2>₹25,000</h2>
                <p>Total Sales</p>
            </div>
            <div class="card">
                <h2>₹15,000</h2>
                <p>Total Purchases</p>
            </div>
            <div class="card">
                <h2>45</h2>
                <p>Products</p>
            </div>
            <div class="card">
                <h2 class="low">5</h2>
                <p>Low Stock Items</p>
            </div>
        </div>

        <!-- GRID -->
        <div class="grid">

            <!-- LEFT -->
            <div class="box">
                <h3>Recent Sales</h3>

                <table>
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Amount</th>
                    </tr>
                    <tr>
                        <td>Shirt</td>
                        <td>2</td>
                        <td>₹800</td>
                    </tr>
                    <tr>
                        <td>Shoes</td>
                        <td>1</td>
                        <td>₹1200</td>
                    </tr>
                    <tr>
                        <td>Bag</td>
                        <td>3</td>
                        <td>₹1500</td>
                    </tr>
                </table>
            </div>

            <!-- RIGHT -->
            <div class="box">
                <h3>Inventory Summary</h3>

                <p>Total Stock: <b>200 Items</b></p>
                <p>Low Stock: <span class="low">5 Items</span></p>
                <p>Out of Stock: 2 Items</p>
            </div>

        </div>

        <!-- EXTRA SECTION -->
        <div class="box" style="margin-top:20px;">
            <h3>Top Selling Products</h3>

            <table>
                <tr>
                    <th>Product</th>
                    <th>Sold</th>
                </tr>
                <tr>
                    <td>T-Shirt</td>
                    <td>25</td>
                </tr>
                <tr>
                    <td>Jeans</td>
                    <td>18</td>
                </tr>
                <tr>
                    <td>Cap</td>
                    <td>12</td>
                </tr>
            </table>
        </div>

    </div>
</div>